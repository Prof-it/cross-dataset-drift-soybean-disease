# Run configuration / secrets. Fill in your own values.
#   Local:  copy to `.env` (gitignored).
#   Colab:  copy to your Drive as `MyDrive/cross-dataset-drift-soybean-disease.env`.
# Never commit a real token.

# Fine-grained, read-only token with Contents:Read on your copy of this repo.
GITHUB_PAT=your_read_only_token_here

# HTTPS clone URL of your repository.
GITHUB_REPO_URL=https://github.com/<owner>/<repo>.git

# Branch to clone.
GIT_BRANCH=main

# Google Drive folder (under MyDrive) holding the dataset zips and the persisted
# training artifacts (checkpoints / results / logs).
DRIVE_ROOT=<your-drive-folder>
